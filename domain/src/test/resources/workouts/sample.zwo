<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
    <author>Blockwork tests</author>
    <name>Over-Unders</name>
    <description>Synthetic test workout</description>
    <sportType>bike</sportType>
    <tags><tag name="THRESHOLD"/></tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.40" PowerHigh="0.75" pace="0"/>
        <SteadyState Duration="300.0" Power="0.88" Cadence="90">
            <textevent timeoffset="10" message="Settle in"/>
        </SteadyState>
        <IntervalsT Repeat="3" OnDuration="120" OffDuration="60" OnPower="1.05" OffPower="0.95"/>
        <FreeRide Duration="180" FlatRoad="1"/>
        <Cooldown Duration="300" PowerLow="0.30" PowerHigh="0.65"/>
        <SomethingNew Duration="30"/>
    </workout>
</workout_file>
